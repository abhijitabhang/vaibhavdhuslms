PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vaibhavdhus_lms

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
VIDEO_SIGNING_SECRET=your_video_signing_secret_here
VIDEO_TOKEN_EXPIRY_SECONDS=180

# Platform Policy
MAX_CONCURRENT_SESSIONS=1
ENFORCE_SINGLE_DEVICE=true

# Storage Paths
STORAGE_DIR=../storage
VIDEO_STORAGE_PATH=../storage/videos
RESOURCE_STORAGE_PATH=../storage/resources
UPLOAD_STORAGE_PATH=../storage/uploads

# Client Origin
CLIENT_URL=http://localhost:5173
